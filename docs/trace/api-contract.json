        "F-PERF-01",
        "F-CLEAN-08",
        "F-SYNC-03",
        "F-SYNC-04",
        "F-SYNC-05"
      ],
      "description": "按评分降序返回未归档页面。同分按 lastVisitedAt 倒序。",
      "request": {
        "query.limit": "integer 1–500，默认 20",
        "query.domain": "string，可选；只返回 domain 等于该值或为其子域的页面",
        "query.openOnly": "\"true\" | \"false\"，可选，默认 false",
        "query.now": "integer(ms)，可选；覆盖「当前时间」（D-01），用于复现与边界测试"
      },
      "response": {
        "pages": "array：{ id, url, normalizedUrl, title, domain, visitCount, lastVisitedAt, firstSeenAt, sources: string[], isOpen, isActive, isImportant, score: number(0–1, 2 位小数), scoreDetail: { recency, frequency, open, domain, domainSource: \"affinity\"|\"important\"|\"protected\"|\"boost\" }, reason: string }",
        "total": "number，过滤（domain / openOnly）后、limit 截断前的数量",
        "domains": "string[]（v1.1.0 新增）：全部未归档页面的去重域名，按页面数降序、同数按字母序，最多 50 个；不受本次 domain / openOnly / limit 过滤影响，供插件域名筛选下拉使用",
        "generatedAt": "number(ms)，实际计算 score / reason 所用的 now（= 排序快照 builtAt；默认快照最多比请求时刻落后 1 小时，超过即同步重建；带 ?now= 时等于该值）"
      },
      "responseExample": {
        "pages": [
          {
            "id": "page_2",
            "url": "https://github.com/org/repo/issues/123",
            "normalizedUrl": "https://github.com/org/repo/issues/123",
            "title": "Fix login redirect bug",
            "domain": "github.com",
            "visitCount": 8,
            "lastVisitedAt": 1710090000000,
            "firstSeenAt": 1710090000000,
            "sources": [
              "history",
              "open_tab"
            ],
            "isOpen": true,
            "isActive": false,
            "isImportant": false,
            "score": 1,
            "scoreDetail": {
              "recency": 0.99,
              "frequency": 1,
              "open": 1,
              "domain": 1,
              "domainSource": "affinity"
            },
            "reason": "最近 3 天内多次访问（8 次），当前仍处于打开状态，常用域名 github.com"
          }
        ],
        "total": 10,
        "domains": [
          "github.com",
          "developer.mozilla.org"
        ],
        "generatedAt": 1710100300000
      },
      "errors": [
        {
          "status": 400,
          "when": "limit 不是 1–500 的整数，或 openOnly 不是 true/false",
          "body": {
            "error": {
              "code": "VALIDATION_FAILED",
              "message": "limit 不是 1–500 的整数，或 openOnly 不是 true/false",
              "details": {
                "fields": [
                  "limit"
                ]
              }
            }
          }
        },
        {
          "status": 400,
          "when": "?now= 不是正整数毫秒时间戳",
          "body": {
            "error": {
              "code": "VALIDATION_FAILED",
              "message": "?now= 不是正整数毫秒时间戳",
              "details": {
                "fields": [
                  "now"
                ]
              }
            }
          }
        }
      ]
    },
