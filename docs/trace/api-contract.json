{
  "$comment": "后端是契约 owner。字段沿用 PROBLEM.md 的 camelCase，只增不减（BE-NAME-02）。文档：docs/03-技术方案-后端.md 第 5 章。",
  "version": "1.1.0",
  "defaultPort": 3000,
  "defaultHost": "127.0.0.1",
  "common": {
    "contentType": "application/json; charset=utf-8；时间戳统一为毫秒 number",
    "requestId": "请求头 x-request-id 原样回传（缺省时生成 req_<随机>），并写入该请求的全部日志",
    "cors": "允许来源 chrome-extension://*、http://localhost:*、http://127.0.0.1:*；OPTIONS 预检 204，Access-Control-Allow-Methods: GET, POST, PUT, PATCH, DELETE, OPTIONS；Access-Control-Allow-Headers: content-type, x-request-id；Access-Control-Expose-Headers: x-request-id；其他来源不返回 Access-Control-Allow-Origin",
    "nowOverride": "GET /api/pages/ranked、POST /api/recommendations/next、GET /api/pages/cleanup-suggestions 支持 ?now=<毫秒>（D-01）",
    "errorFormat": {
      "error": {
        "code": "UPPER_SNAKE",
        "message": "给人看的中文说明",
        "details": "可选，例如 { fields: [\"openTabs\"] }"
      }
    },
    "errorCodes": [
      {
        "code": "INVALID_JSON",
        "status": 400,
        "when": "请求体不是合法 JSON"
      },
      {
        "code": "VALIDATION_FAILED",
        "status": 400,
        "when": "字段缺失、类型或取值错误；details.fields 列出字段"
      },
      {
        "code": "UNSUPPORTED_MEDIA_TYPE",
        "status": 415,
        "when": "有请求体但 Content-Type 不是 application/json"
      },
      {
        "code": "NOT_FOUND",
        "status": 404,
        "when": "路由不存在或资源不存在"
      },
      {
        "code": "METHOD_NOT_ALLOWED",
        "status": 405,
        "when": "路径存在但方法不支持（带 Allow 头）"
      },
      {
        "code": "PAYLOAD_TOO_LARGE",
        "status": 413,
        "when": "请求体超过 1 MB，或数组超过 500 条"
      },
      {
        "code": "INTERNAL",
        "status": 500,
        "when": "未预期异常；details 只含 reqId"
      }
    ],
    "limits": {
      "maxBodyBytes": 1048576,
      "maxItemsPerArray": 500,
      "maxUrlLength": 2048,
      "maxTitleLength": 500,
      "ruleTextLength": "1–500",
      "maxRulesPerSave": 20,
      "recentHistoryUsed": 20
    },
    "env": {
      "PORT": "默认 3000",
      "HOST": "默认 127.0.0.1",
      "ENABLE_TEST_API": "=1 时注册 POST /api/__test__/reset",
      "LOG_FILE": "设置后同步追加 JSON 日志（自动创建目录）",
      "LOG_LEVEL": "debug | info | warn | error，默认 info",
      "SNAPSHOT_FILE": "设置后启用 JSON 快照持久化"
    }
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/sync",
      "codePoints": [
        "C-BE-SYNC-01",
        "C-BE-SYNC-02",
        "C-BE-SYNC-03",
        "C-BE-SYNC-04",
        "C-BE-SYNC-05",
        "C-BE-PRIV-01",
        "C-BE-PRIV-02",
        "C-BE-CORE-05",
        "C-BE-CORE-09",
        "C-BE-CORE-10"
      ],
      "features": [
        "F-SYNC-01",
        "F-SYNC-02",
        "F-SYNC-03",
        "F-SYNC-04",
        "F-SYNC-05",
        "F-SYNC-07",
        "F-PRIV-03",
        "F-PRIV-05",
        "F-DEMO-02"
      ],
      "description": "上报浏览器上下文：按 normalizedUrl 去重合并入库；isOpen / isActive 按本次快照刷新；单条坏记录计入 rejected，不影响其他记录。",
      "request": {
        "activeTab": "object | null，可缺省：{ url: string, title?: string, lastAccessed?: number(ms) }；当前系统页时传 null",
        "openTabs": "array，可缺省（视为 []），最多 500 条：{ url, title?, lastAccessed?: number(ms) }（所有普通窗口的标签页，D-21）",
        "history": "array，可缺省（视为 []），最多 500 条：{ url, title?, lastVisitTime: number(ms), visitCount?: number }",
        "clientVersion": "string，可选，插件版本，写入 SyncLog",
        "mode": "\"full\" | \"incremental\"，可选，默认 full；只写入 SyncLog，不改变合并语义",
        "cursor": "number(ms)，可选，增量同步游标，只写入 SyncLog"
      },
      "requestExample": {
        "activeTab": {
          "url": "https://github.com/org/repo/pull/456",
          "title": "Refactor auth middleware (#456)"
        },
        "openTabs": [
          {
            "url": "https://github.com/org/repo/issues/123",
            "title": "Fix login redirect bug"
          }
        ],
        "history": [
          {
            "url": "https://github.com/org/repo/issues/123",
            "title": "Fix login redirect bug",
            "lastVisitTime": 1710090000000,
            "visitCount": 8
          }
        ]
      },
      "response": {
        "ok": "boolean，恒为 true",
        "syncedAt": "number(ms)，服务器处理时间；activeTab 页面的 lastVisitedAt 等于它",
        "received": "number，activeTab(0/1) + openTabs + history 的条数（含被拒收的）",
        "created": "number，新建的页面数",
        "updated": "number，命中已有页面（含本请求内重复 URL）的条数",
        "rejected": "number，被拒收的条数（URL 不合法 / 非 http(s) / 超过 2048 字符 / 命中敏感关键词）",
        "rejectedByReason": "{ invalid_url: number, privacy: number }（新增字段，只有计数，不回显 URL）",
        "pageCount": "number，同步后后端页面总数（含已归档）",
        "mode": "\"full\" | \"incremental\""
      },
      "responseExample": {
        "ok": true,
        "syncedAt": 1710100300000,
        "received": 14,
        "created": 10,
        "updated": 4,
        "rejected": 0,
        "rejectedByReason": {
          "invalid_url": 0,
          "privacy": 0
        },
        "pageCount": 10,
        "mode": "full"
      },
      "errors": [
        {
          "status": 400,
          "when": "请求体不是合法 JSON",
          "body": {
            "error": {
              "code": "INVALID_JSON",
              "message": "请求体不是合法 JSON"
            }
          }
        },
        {
          "status": 415,
          "when": "有请求体但 Content-Type 不是 application/json",
          "body": {
            "error": {
              "code": "UNSUPPORTED_MEDIA_TYPE",
              "message": "Content-Type 必须是 application/json"
            }
          }
        },
        {
          "status": 413,
          "when": "请求体超过 1 MB",
          "body": {
            "error": {
              "code": "PAYLOAD_TOO_LARGE",
              "message": "请求体超过 1 MB 上限"
            }
          }
        },
        {
          "status": 400,
          "when": "请求体不是对象，或 activeTab 不是对象 / null，或 openTabs / history 不是数组，或 mode 取值非法",
          "body": {
            "error": {
              "code": "VALIDATION_FAILED",
              "message": "请求体不是对象，或 activeTab 不是对象 / null，或 openTabs / history 不是数组，或 mode 取值非法",
              "details": {
                "fields": [
                  "openTabs"
                ]
              }
            }
          }
        },
        {
          "status": 413,
          "when": "openTabs 或 history 超过 500 条",
          "body": {
            "error": {
              "code": "PAYLOAD_TOO_LARGE",
              "message": "history 最多 500 条"
            }
          }
        }
      ]
    },
    {
      "method": "GET",
      "path": "/api/pages/ranked",
      "codePoints": [
        "C-BE-RANK-01",
        "C-BE-RANK-02",
        "C-BE-RANK-03",
        "C-BE-RANK-04",
        "C-BE-RANK-05",
        "C-BE-CORE-07",
        "C-BE-CORE-13"
